# Ollama bridge
OLLAMA_URL=http://localhost:11434

# Database
DATABASE_URL=sqlite:///./dispatch.db

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default ollama model used when an agent has none set
DEFAULT_MODEL=qwen3:8b

# Vision model for reading screenshots in 截圖排程 (needs a vision-capable model)
VISION_MODEL=qwen2.5vl:7b

# Frontend URL (used to redirect back after Google OAuth) and calendar timezone
FRONTEND_URL=http://localhost:5173
TIMEZONE=Asia/Taipei

# Google Calendar OAuth (from Google Cloud Console -> Credentials -> OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
